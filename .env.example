# --- Server ---
PORT=3000
# Frontend URL(s) allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=apexdesk
# Set to true for cloud databases that require SSL
DB_SSL=false

# --- SLA engine: minutes before a ticket breaches its SLA ---
SLA_URGENT_MINUTES=30
SLA_HIGH_MINUTES=60
SLA_NORMAL_MINUTES=240
SLA_LOW_MINUTES=1440

# --- Auth ---
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h
